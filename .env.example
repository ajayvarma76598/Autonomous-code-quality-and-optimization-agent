# ==========================================
# 1. App Configuration
# ==========================================
LOG_LEVEL=INFO
TEMP=/tmp

# ==========================================
# 2. Database (PostgreSQL with pgvector)
# ==========================================
DATABASE_URL=postgresql://user:password@localhost:5432/code_quality_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=code_quality_db

# ==========================================
# 3. Redis & Caching
# ==========================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# 4. LLM Provider Configuration
# ==========================================
LLM_PROVIDER=azure # Choose 'azure' or 'openai'

# Azure OpenAI Setup
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_OPENAI_API_KEY=your_api_key
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_LLM_DEPLOYMENT=gpt-4o
AZURE_OPENAI_FAST_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Standard OpenAI Setup (Fallback)
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# ==========================================
# 5. Observability (Langfuse)
# ==========================================
LANGFUSE_PUBLIC_KEY=your_public_key
LANGFUSE_SECRET_KEY=your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# ==========================================
# 6. Data Ingestion & Parsing
# ==========================================
LLAMA_CLOUD_API_KEY=your_llama_cloud_key
REPOS_STORAGE_DIR=./repositories
AUTO_INGEST_PDFS=false

# ==========================================
# 7. External Analysis Tools
# ==========================================
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=your_sonarqube_token

# ==========================================
# 8. Authentication (Auth0)
# ==========================================
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_API_AUDIENCE=https://your-api-audience.com/
